APP_NAME=Football Analytics Platform
ENVIRONMENT=development
# Local non-Docker default is SQLite. Docker Compose supplies a PostgreSQL URL.
DATABASE_URL=sqlite:///./storage/football_analytics.db
CORS_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=replace_with_a_local_secret
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=2048
MAX_FRAME_DIMENSION=1280

# Object detection (Module 2)
# DETECTION_MODEL_PATH=/absolute/or/relative/path/to/yolov8n.pt
DETECTION_MODEL_NAME=yolov8n.pt
# DETECTION_DEVICE=cpu  # set to cuda if available
DETECTION_DEFAULT_CONFIDENCE=0.35
DETECTION_DEFAULT_BATCH_SIZE=8
